# EZStore Docker Compose 環境變數
# 複製為 .env 後填入。`.env` 已被 .gitignore 排除，不會進版本控制。

# 模型憑證（三選一，須與 AGENT_MODEL 對應）
# A. Google AI Studio API key（建議，免費方案即可）：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# B. Vertex AI（需要 GCP 專案與 gcloud auth application-default login；Docker 內另需掛載 ADC 憑證）
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# C. OpenAI（AGENT_MODEL 要改成 openai/ 開頭，例如 openai/gpt-5-mini）
# OPENAI_API_KEY=

# 選填：Agent 意圖分類使用的模型。gemini-* 走 Gemini；openai/<模型> 走 OpenAI
AGENT_MODEL=gemini-3.8-flash
# 選填：eval 的 LLM 評審模型，沒設就沿用 AGENT_MODEL
# JUDGE_MODEL=

# 選填：前端對外網址（Agent 回覆中的系統連結）與允許的 CORS 來源
FRONTEND_URL=http://localhost:3000
ALLOW_ORIGINS=http://localhost:3000

# 選填：MCP Server 對本機開放的埠（本機跑 agents-cli eval 時用 MCP_URL=http://localhost:8010/mcp）
MCP_HOST_PORT=8010
